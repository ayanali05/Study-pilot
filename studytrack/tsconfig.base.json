{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@studytrack/data": ["packages/data/src/index.ts"],
      "@studytrack/data/config": ["packages/data/src/config.ts"],
      "@studytrack/data/schemas": ["packages/data/src/schemas.ts"],
      "@studytrack/data/*": ["packages/data/src/*"],
      "@studytrack/engine": ["packages/engine/src/index.ts"],
      "@studytrack/engine/*": ["packages/engine/src/*"],
      "@studytrack/ui": ["packages/ui/src/index.ts"],
      "@studytrack/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
