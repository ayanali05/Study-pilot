# ==============================================================================
# StudyPilot / StudyTrack Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local to configure local development secrets.

# Google Gemini Generative AI API Key (Required for live RAG StudyCoach & Dynamic MCQ generation)
# Obtain a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Public Base URL for SEO Metadata, OpenGraph cards, sitemap, and canonical links
NEXT_PUBLIC_APP_URL=https://study-pilot.vercel.app

# Optional Supabase integration for persistent cloud database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
